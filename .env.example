# Copy to .env.local (dev) or set in the build environment.

# API base URL on the API's own origin, including the /api prefix. Sign-in is a full-page
# navigation to it, and the API builds GitHub's redirect_uri from the host it arrives on.
# Unset = /api on the front end's own origin.
# Production: https://shift-api.developkerr.com/api
# Local .NET API (matches the dev GitHub App's callback): https://localhost:7194/api
VITE_API_URL=
