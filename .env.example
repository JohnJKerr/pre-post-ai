# Copy to .env.local (dev) or set in the build environment.

# API base URL, including the /api prefix. Unset = /api on the front end's own origin.
# Production: https://shift-api.developkerr.com/api
# Local .NET API (http launch profile): http://localhost:5101/api
VITE_API_URL=

# false = call the real API instead of the MSW mock
VITE_API_MOCK=
